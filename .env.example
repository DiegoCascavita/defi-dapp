# Network mode: anvil (default) | sepolia
# NEXT_PUBLIC_NETWORK=anvil
# NEXT_PUBLIC_NETWORK=sepolia

# --- Anvil (local) — optional overrides after a fresh deploy, or run npm run sync:anvil ---
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_LENDING_POOL=0x0165878A594ca255338adfa4d48449f69242Eb8F
NEXT_PUBLIC_WETH=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
NEXT_PUBLIC_DAI=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
NEXT_PUBLIC_PRIMARY_FEED=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_SECONDARY_ORACLE=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# Cascade Vault (Anvil demo — own mock DAI, not lending DAI). Or: npm run sync:vault
NEXT_PUBLIC_CASCADE_VAULT=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
NEXT_PUBLIC_VAULT_ASSET=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_IDLE_STRATEGY=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# --- Sepolia (public) — uncomment this block and comment/remove the Anvil block above ---
# Public contract addresses only. Never put PRIVATE_KEY, mnemonic, or RPC API keys with write
# access into this file or into git. Optional: use your own public read RPC via NEXT_PUBLIC_RPC_URL.
# NEXT_PUBLIC_NETWORK=sepolia
# NEXT_PUBLIC_CHAIN_ID=11155111
# NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEXT_PUBLIC_LENDING_POOL=0x732D2D5E745203eff3a4084d771ceB27B84f665B
# NEXT_PUBLIC_WETH=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
# NEXT_PUBLIC_DAI=0x3e98D8700FfD75078F918870BA13f32a177a7cbd
# NEXT_PUBLIC_PRIMARY_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306
# NEXT_PUBLIC_SECONDARY_ORACLE=0xaC1F2E02A7bdb40FC3521d6b6Cbffbd6BC6d3c09
# Vault placeholders until Sepolia deploy (leave zero / unset):
# NEXT_PUBLIC_CASCADE_VAULT=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_VAULT_ASSET=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_IDLE_STRATEGY=0x0000000000000000000000000000000000000000

# Optional WalletConnect Cloud project id (injected MetaMask works without it)
# NEXT_PUBLIC_WC_PROJECT_ID=
